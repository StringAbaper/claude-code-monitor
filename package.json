{
  "name": "claude-code-monitor",
  "version": "1.8.0",
  "description": "Real-time monitor for Claude Code sessions across multiple IDEs and terminals",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test lib/*.test.js",
    "reset-password": "node scripts/reset-password.js",
    "install-hooks": "node install-hooks.js",
    "uninstall-hooks": "node install-hooks.js --remove",
    "deploy": "node deploy.js",
    "autostart": "node scripts/autostart.js install",
    "autostart:remove": "node scripts/autostart.js uninstall",
    "autostart:restart": "node scripts/autostart.js restart",
    "autostart:status": "node scripts/autostart.js status"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0"
  }
}
